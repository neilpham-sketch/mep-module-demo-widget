{
  "name": "@prowerbdigital/module-demo-widget-api",
  "version": "0.0.1",
  "description": "Demo Widget — MEP SaaS v2 module backend",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build --all",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/internal/main",
    "start:prod:external": "node dist/apps/external/main",
    "start:prod:worker": "node dist/apps/worker/main",
    "dev:internal": "nest start internal --watch",
    "dev:external": "nest start external --watch",
    "dev:worker": "nest start worker --watch",
    "lint": "biome check --write apps/ libs/",
    "lint:check": "biome check apps/ libs/",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "verify:manifest": "tsx scripts/verify-manifest.ts",
    "setup:github": "bash scripts/setup-github-repo.sh",
    "e2e": "pnpm --filter @prowerbdigital/module-demo-widget-e2e test"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.0.0",
    "@godaddy/terminus": "^4.12.0",
    "@prowerbdigital/common": "workspace:*",
    "@prowerbdigital/contract": "workspace:*",
    "@golevelup/nestjs-rabbitmq": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "joi": "^18.0.2",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.10",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}

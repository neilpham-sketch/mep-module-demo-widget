# The "resources" env layer — every var except NODE_ENV.
# Copy to apps/worker/venv/.env.${NODE_ENV}, e.g. apps/worker/venv/.env.dev
# Loaded after apps/worker/.env by loadEnv('worker') / DynamicConfigModule.

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=8082
LOG_LEVEL=debug

# ─── Database (Drizzle / node-postgres) ─────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nestjs_mep
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=5m
DB_CONNECT_TIMEOUT=30s

# ─── RabbitMQ (mep.cdc consumer) ─────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

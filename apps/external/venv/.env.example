# The "resources" env layer — every var except NODE_ENV.
# Copy to apps/external/venv/.env.${NODE_ENV}, e.g. apps/external/venv/.env.dev
# Loaded after apps/external/.env by loadEnv('external') / DynamicConfigModule.

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=8081
LOG_LEVEL=debug

# ─── Database (Drizzle / node-postgres) ─────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nestjs_mep
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=5m
DB_CONNECT_TIMEOUT=30s

{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/internal/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/internal/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/internal",
  "projects": {
    "internal": {
      "type": "application",
      "root": "apps/internal",
      "entryFile": "main",
      "sourceRoot": "apps/internal/src",
      "compilerOptions": { "tsConfigPath": "apps/internal/tsconfig.app.json" }
    },
    "external": {
      "type": "application",
      "root": "apps/external",
      "entryFile": "main",
      "sourceRoot": "apps/external/src",
      "compilerOptions": { "tsConfigPath": "apps/external/tsconfig.app.json" }
    },
    "worker": {
      "type": "application",
      "root": "apps/worker",
      "entryFile": "main",
      "sourceRoot": "apps/worker/src",
      "compilerOptions": { "tsConfigPath": "apps/worker/tsconfig.app.json" }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": { "tsConfigPath": "libs/common/tsconfig.lib.json" }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": { "tsConfigPath": "libs/database/tsconfig.lib.json" }
    },
    "layer-data": {
      "type": "library",
      "root": "libs/layer-data",
      "entryFile": "index",
      "sourceRoot": "libs/layer-data/src",
      "compilerOptions": { "tsConfigPath": "libs/layer-data/tsconfig.lib.json" }
    }
  }
}

# Values read by scripts/setup-github-repo.sh (via `pnpm setup:github`). Copy this file to
# .env.setup-github and fill in the real values — that file is gitignored (chmod 600 it,
# since it holds live credentials) and must never be committed.
#
# Anything left blank here is simply skipped by the script (it prints which secrets/vars it
# couldn't set and why) — you don't need every value to run it.

# Personal access token (classic, `repo` scope) or fine-grained token with
# Contents/Administration/Secrets/Environments write on this repo + Administration on the
# org (needed only to create the repo itself). Used solely for GitHub REST API calls —
# `git push` still uses whatever auth you already have configured for github.com (SSH key
# or credential helper), not this token.
GITHUB_TOKEN=

# Org the repo is created under. Optional — defaults to ProwerbDigital in the script; only
# set this if you're intentionally targeting a different org/account (e.g. a personal fork
# for a dry run).
MEP_GITHUB_ORG=

# --- Repo secret (shared across qa and staging — same value both places) ---

# GitHub PAT (read:packages + repo) — used by CI to pull @prowerbdigital/* from GitHub
# Packages, and by the deploy host to `git clone` this repo over HTTPS.
GH_TOKEN=

# --- Per-environment secrets and variables ---
# Everything below differs between qa and staging, so each has its own QA_/STAGING_
# prefix. The script strips the prefix and writes the value into the matching GitHub
# Environment ("qa" or "staging") under the bare name — e.g. QA_HOST becomes the "HOST"
# variable inside the "qa" environment, and independently STAGING_HOST becomes "HOST"
# inside "staging".

# AWS IAM credentials with ECR push access (long-lived keys, not OIDC — matches what's
# actually wired up on the shared runners today).
QA_AWS_ACCESS_KEY_ID=
QA_AWS_SECRET_ACCESS_KEY=
STAGING_AWS_ACCESS_KEY_ID=
STAGING_AWS_SECRET_ACCESS_KEY=

# AWS region and account ID — used to build the ECR registry hostname
# (<account>.dkr.ecr.<region>.amazonaws.com).
QA_AWS_REGION=
QA_AWS_ACCOUNT_ID=
STAGING_AWS_REGION=
STAGING_AWS_ACCOUNT_ID=

# Deploy host + SSH user.
QA_SSH_HOST=
QA_SSH_USER=
STAGING_SSH_HOST=
STAGING_SSH_USER=

# Deploy SSH private key — raw PEM or base64, auto-detected. Multi-line values work fine in
# a bash-sourced file: wrap in double quotes across multiple lines, e.g.:
# QA_SSH_PRIVATE_KEY_B64="-----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----"
QA_SSH_PRIVATE_KEY_B64=
STAGING_SSH_PRIVATE_KEY_B64=

# Public hostname for this environment, written into docker/.env on the deploy host.
QA_HOST=
STAGING_HOST=

# Infisical (self-hosted secrets manager) — the container fetches its real runtime config
# (DATABASE_URL, RABBITMQ_URL, ...) from here at boot via `infisical run`, not from any file
# in this repo. Needs a "/mep-module-<key>-{internal,external,worker}" secret path created
# per environment inside this project first (see the script's final printout).
QA_INFISICAL_PROJECT_ID=
QA_INFISICAL_TOKEN=
QA_INFISICAL_ENV=
QA_INFISICAL_DOMAIN=
STAGING_INFISICAL_PROJECT_ID=
STAGING_INFISICAL_TOKEN=
STAGING_INFISICAL_ENV=
STAGING_INFISICAL_DOMAIN=

# MS Teams incoming-webhook URL for deploy notifications.
QA_MSTEAMS_WEBHOOK_URL=
STAGING_MSTEAMS_WEBHOOK_URL=
